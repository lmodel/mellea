PREFIX mellea: <https://w3id.org/lmodel/mellea/>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX schema: <http://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX attack: <https://w3id.org/lmodel/attack/>
PREFIX common_domain_model: <https://w3id.org/lmodel/common-domain-model/>
PREFIX gist_linkml: <https://w3id.org/lmodel/gist/>
PREFIX iso27001: <https://w3id.org/lmodel/iso27001/>
PREFIX mcp: <https://w3id.org/lmodel/mcp/>
PREFIX nexus: <https://ibm.github.io/ai-atlas-nexus/ontology/>
PREFIX spdx: <https://spdx.org/rdf/3.0.1/terms/>

SELECT ?g ?s ?p WHERE {
 GRAPH ?g {
  ?s rdf:type mellea:PythonPackage ;
     ?p ?o .
  FILTER ( ?p NOT IN (
   mellea:package_name,
   mellea:depends_on_package,
   mellea:declares_element,
   schema:identifier,
   schema:name,
   schema:description,
   mellea:module_path,
   mellea:source_file,
   mellea:package_kind,
   mellea:element_kind,
   mellea:coverage_scope,
   mellea:tags,
   rdf:type ))
 }
 
} 







