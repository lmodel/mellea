Ref: RepositoryCatalog.declares_element > ModelElement.id
Ref: PythonPackage.depends_on_package > PythonPackage.id
Ref: PythonPackage.declares_element > ModelElement.id
Ref: BackendSpec.model_identifier > ModelIdentifierSpec.id
Ref: BackendSpec.default_formatter > FormatterSpec.id
Ref: SessionSpec.uses_backend > BackendSpec.id
Ref: SessionSpec.uses_context > ContextSpec.id
Ref: SessionSpec.exposed_method > MethodSpec.id
Ref: PluginSpec.payload_model > HookPayloadSpec.id
Ref: CliCommandSpec.input_model > ApiModelSpec.id
Ref: CliCommandSpec.output_model > ApiModelSpec.id
Ref: ApiModelSpec.has_field > ApiFieldSpec.id