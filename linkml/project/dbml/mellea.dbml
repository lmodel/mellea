// DBML generated from LinkML schema

Project {
  name: 'mellea'
}

Table NamedElement {
id varchar [not null, primary key]
name varchar [not null]
description varchar
module_path varchar
source_file varchar
package_kind varchar
element_kind varchar
coverage_scope varchar
tags varchar
}

Table RepositoryCatalog {
id varchar [not null, primary key]
