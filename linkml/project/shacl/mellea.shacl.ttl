@prefix mellea: <https://w3id.org/lmodel/mellea/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mellea:CliCommandSpec a sh:NodeShape ;
    rdfs:comment "Specification of a CLI command exposed under `m`." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Narrative description of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "Source file relative to repository root." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path mellea:source_file ;
            sh:pattern "^[^\\0]+$" ],
        [ sh:description "Kind of Python declaration." ;
            sh:in ( "CLASS" "ENUM" "DATACLASS" "TYPED_DICT" "PYDANTIC_MODEL" "PROTOCOL" "FUNCTION" "MIXIN" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path mellea:element_kind ],
        [ sh:datatype xsd:string ;
            sh:description "Python module path where this element is defined." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path mellea:module_path ;
            sh:pattern "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Slot describing the command path." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path mellea:command_path ],
        [ sh:description "Package bucket." ;
            sh:in ( "CORE" "STDLIB" "BACKENDS" "FORMATTERS" "HELPERS" "PLUGINS" "TELEMETRY" "CLI" "DOCS_EXAMPLES" "TEST" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path mellea:package_kind ],
        [ sh:class mellea:ApiModelSpec ;
            sh:description "Slot describing the input model." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path mellea:input_model ],
        [ sh:description "Where this element surfaces (source/API/CLI/example/test)." ;
            sh:in ( "SOURCE" "API" "CLI" "EXAMPLE" "TEST" ) ;
            sh:order 12 ;
            sh:path mellea:coverage_scope ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Slot describing the command group." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path mellea:command_group ],
        [ sh:datatype xsd:string ;
            sh:description "Free-form classification tags." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path mellea:tags ],
        [ sh:description "Stable identifier for a schema element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Slot describing the command purpose." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path mellea:command_purpose ],
        [ sh:class mellea:ApiModelSpec ;
            sh:description "Slot describing the output model." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path mellea:output_model ] ;
    sh:targetClass mellea:CliCommandSpec .

mellea:ComponentSpec a sh:NodeShape ;
    rdfs:comment "Specification of a Mellea stdlib component type." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Package bucket." ;
            sh:in ( "CORE" "STDLIB" "BACKENDS" "FORMATTERS" "HELPERS" "PLUGINS" "TELEMETRY" "CLI" "DOCS_EXAMPLES" "TEST" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path mellea:package_kind ],
        [ sh:datatype xsd:string ;
            sh:description "Narrative description of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:description ],
        [ sh:description "Where this element surfaces (source/API/CLI/example/test)." ;
            sh:in ( "SOURCE" "API" "CLI" "EXAMPLE" "TEST" ) ;
            sh:order 10 ;
            sh:path mellea:coverage_scope ],
        [ sh:description "Stable identifier for a schema element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path schema1:identifier ],
        [ sh:description "Slot describing the component category." ;
            sh:in ( "INSTRUCTION" "MESSAGE" "TOOL_MESSAGE" "DOCUMENT" "INTRINSIC" "MOBJECT" "QUERY" "TRANSFORM" "GENSTUB" "REQUIREMENT" "STREAM_EVENT" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path mellea:component_category ],
        [ sh:datatype xsd:string ;
            sh:description "Source file relative to repository root." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path mellea:source_file ;
            sh:pattern "^[^\\0]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Slot describing the parsed output type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path mellea:parsed_output_type ],
        [ sh:datatype xsd:string ;
            sh:description "Free-form classification tags." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path mellea:tags ],
        [ sh:datatype xsd:string ;
            sh:description "Slot describing the input modality." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path mellea:input_modality ],
        [ sh:datatype xsd:string ;
            sh:description "Python module path where this element is defined." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path mellea:module_path ;
            sh:pattern "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" ],
        [ sh:description "Kind of Python declaration." ;
            sh:in ( "CLASS" "ENUM" "DATACLASS" "TYPED_DICT" "PYDANTIC_MODEL" "PROTOCOL" "FUNCTION" "MIXIN" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path mellea:element_kind ] ;
    sh:targetClass mellea:ComponentSpec .

mellea:IntrinsicAdapterSpec a sh:NodeShape ;
    rdfs:comment "Specification of an intrinsic adapter (LoRA / aLoRA)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-form classification tags." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path mellea:tags ],
        [ sh:datatype xsd:string ;
            sh:description "Narrative description of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "Slot describing the repo id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path mellea:repo_id ],
        [ sh:description "Package bucket." ;
            sh:in ( "CORE" "STDLIB" "BACKENDS" "FORMATTERS" "HELPERS" "PLUGINS" "TELEMETRY" "CLI" "DOCS_EXAMPLES" "TEST" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path mellea:package_kind ],
        [ sh:description "Where this element surfaces (source/API/CLI/example/test)." ;
            sh:in ( "SOURCE" "API" "CLI" "EXAMPLE" "TEST" ) ;
            sh:order 9 ;
            sh:path mellea:coverage_scope ],
        [ sh:description "Stable identifier for a schema element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Python module path where this element is defined." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path mellea:module_path ;
            sh:pattern "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Source file relative to repository root." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path mellea:source_file ;
            sh:pattern "^[^\\0]+$" ],
        [ sh:description "Kind of Python declaration." ;
            sh:in ( "CLASS" "ENUM" "DATACLASS" "TYPED_DICT" "PYDANTIC_MODEL" "PROTOCOL" "FUNCTION" "MIXIN" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path mellea:element_kind ],
        [ sh:description "Slot describing the adapter type." ;
            sh:in ( "LORA" "ALORA" ) ;
            sh:order 1 ;
            sh:path mellea:adapter_type ] ;
    sh:targetClass mellea:IntrinsicAdapterSpec .

mellea:NamedElement a sh:NodeShape ;
    rdfs:comment "Abstract base for any named, identifiable schema element." ;
    sh:closed false ;
    sh:ignoredProperties ( mellea:payload_model mellea:field_type mellea:watsonx_name mellea:provider_name mellea:hook_type mellea:command_path mellea:metric_name mellea:package_name mellea:bedrock_name mellea:ollama_name mellea:plugin_priority mellea:openai_name mellea:supports_streaming mellea:validation_style mellea:repo_id mellea:includes_path mellea:hf_model_name mellea:component_category mellea:command_purpose mellea:selection_policy mellea:loop_budget_hint mellea:method_signature mellea:analyzed_on mellea:input_modality mellea:plugin_mode mellea:depends_on_package mellea:excludes_path mellea:context_linearity mellea:openai_object_type mellea:command_group mellea:allows_null mellea:lifecycle_role mellea:declares_element mellea:model_options_key mellea:default_formatter mellea:stores_component_history mellea:required_field mellea:method_name mellea:output_model rdf:type mellea:uses_context mellea:accepts_message_attachments mellea:has_field mellea:may_trigger_repair mellea:field_name mellea:uses_backend mellea:supports_tool_calls mellea:backend_family mellea:supports_multimodal mellea:input_model mellea:request_or_response mellea:parsed_output_type mellea:adapter_type mellea:model_identifier mellea:exposed_method mellea:repository_root ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:description "Where this element surfaces (source/API/CLI/example/test)." ;
            sh:in ( "SOURCE" "API" "CLI" "EXAMPLE" "TEST" ) ;
            sh:order 7 ;
            sh:path mellea:coverage_scope ],
        [ sh:datatype xsd:string ;
            sh:description "Free-form classification tags." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path mellea:tags ],
        [ sh:description "Stable identifier for a schema element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Source file relative to repository root." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path mellea:source_file ;
            sh:pattern "^[^\\0]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Narrative description of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:description ],
        [ sh:description "Package bucket." ;
            sh:in ( "CORE" "STDLIB" "BACKENDS" "FORMATTERS" "HELPERS" "PLUGINS" "TELEMETRY" "CLI" "DOCS_EXAMPLES" "TEST" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path mellea:package_kind ],
        [ sh:datatype xsd:string ;
            sh:description "Python module path where this element is defined." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path mellea:module_path ;
            sh:pattern "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" ],
        [ sh:description "Kind of Python declaration." ;
            sh:in ( "CLASS" "ENUM" "DATACLASS" "TYPED_DICT" "PYDANTIC_MODEL" "PROTOCOL" "FUNCTION" "MIXIN" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path mellea:element_kind ] ;
    sh:targetClass mellea:NamedElement .

mellea:PluginSpec a sh:NodeShape ;
    rdfs:comment "Specification of a Mellea plugin and the hooks it registers." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Slot describing the plugin mode." ;
            sh:in ( "SEQUENTIAL" "TRANSFORM" "CONCURRENT" "AUDIT" "FIRE_AND_FORGET" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path mellea:plugin_mode ],
        [ sh:datatype xsd:string ;
            sh:description "Python module path where this element is defined." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path mellea:module_path ;
            sh:pattern "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" ],
        [ sh:description "Stable identifier for a schema element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path schema1:identifier ],
        [ sh:description "Package bucket." ;
            sh:in ( "CORE" "STDLIB" "BACKENDS" "FORMATTERS" "HELPERS" "PLUGINS" "TELEMETRY" "CLI" "DOCS_EXAMPLES" "TEST" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path mellea:package_kind ],
        [ sh:description "Where this element surfaces (source/API/CLI/example/test)." ;
            sh:in ( "SOURCE" "API" "CLI" "EXAMPLE" "TEST" ) ;
            sh:order 11 ;
            sh:path mellea:coverage_scope ],
        [ sh:datatype xsd:integer ;
            sh:description "Slot describing the plugin priority." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path mellea:plugin_priority ],
        [ sh:description "Kind of Python declaration." ;
            sh:in ( "CLASS" "ENUM" "DATACLASS" "TYPED_DICT" "PYDANTIC_MODEL" "PROTOCOL" "FUNCTION" "MIXIN" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path mellea:element_kind ],
        [ sh:description "Slot describing the hook type." ;
            sh:in ( "SESSION_PRE_INIT" "SESSION_POST_INIT" "SESSION_RESET" "SESSION_CLEANUP" "COMPONENT_PRE_EXECUTE" "COMPONENT_POST_SUCCESS" "COMPONENT_POST_ERROR" "GENERATION_PRE_CALL" "GENERATION_POST_CALL" "GENERATION_ERROR" "VALIDATION_PRE_CHECK" "VALIDATION_POST_CHECK" "SAMPLING_LOOP_START" "SAMPLING_ITERATION" "SAMPLING_REPAIR" "SAMPLING_LOOP_END" "TOOL_PRE_INVOKE" "TOOL_POST_INVOKE" ) ;
            sh:order 1 ;
            sh:path mellea:hook_type ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-form classification tags." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path mellea:tags ],
        [ sh:datatype xsd:string ;
            sh:description "Narrative description of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:description ],
        [ sh:class mellea:HookPayloadSpec ;
            sh:description "Slot describing the payload model." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path mellea:payload_model ],
        [ sh:datatype xsd:string ;
            sh:description "Source file relative to repository root." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path mellea:source_file ;
            sh:pattern "^[^\\0]+$" ] ;
    sh:targetClass mellea:PluginSpec .

mellea:RepositoryCatalog a sh:NodeShape ;
    rdfs:comment "Top-level catalog rooting the analysed repository snapshot." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Stable identifier for a schema element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Free-form classification tags." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path mellea:tags ],
        [ sh:class mellea:ModelElement ;
            sh:description "Slot describing the declares element." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path mellea:declares_element ],
        [ sh:description "Package bucket." ;
            sh:in ( "CORE" "STDLIB" "BACKENDS" "FORMATTERS" "HELPERS" "PLUGINS" "TELEMETRY" "CLI" "DOCS_EXAMPLES" "TEST" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path mellea:package_kind ],
        [ sh:datatype xsd:string ;
            sh:description "Python module path where this element is defined." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path mellea:module_path ;
            sh:pattern "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" ],
        [ sh:description "Where this element surfaces (source/API/CLI/example/test)." ;
            sh:in ( "SOURCE" "API" "CLI" "EXAMPLE" "TEST" ) ;
            sh:order 12 ;
            sh:path mellea:coverage_scope ],
        [ sh:datatype xsd:date ;
            sh:description "Slot describing the analyzed on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path mellea:analyzed_on ],
        [ sh:datatype xsd:string ;
            sh:description "Slot describing the excludes path." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path mellea:excludes_path ;
            sh:pattern "^[^\\0]+$" ],
        [ sh:description "Kind of Python declaration." ;
            sh:in ( "CLASS" "ENUM" "DATACLASS" "TYPED_DICT" "PYDANTIC_MODEL" "PROTOCOL" "FUNCTION" "MIXIN" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path mellea:element_kind ],
        [ sh:datatype xsd:string ;
            sh:description "Source file relative to repository root." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path mellea:source_file ;
            sh:pattern "^[^\\0]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Slot describing the includes path." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path mellea:includes_path ;
            sh:pattern "^[^\\0]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Narrative description of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "Slot describing the repository root." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path mellea:repository_root ;
            sh:pattern "^[^\\0]+$" ] ;
    sh:targetClass mellea:RepositoryCatalog .

mellea:RequirementSpec a sh:NodeShape ;
