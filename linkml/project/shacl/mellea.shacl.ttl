        [ sh:datatype xsd:string ;
            sh:description "Free-form classification tags." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path mellea:tags ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ] ;
    sh:targetClass mellea:RequirementSpec .

mellea:SamplingStrategySpec a sh:NodeShape ;
    rdfs:comment "Specification of a sampling-loop strategy." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Slot describing the may trigger repair." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path mellea:may_trigger_repair ],
        [ sh:description "Stable identifier for a schema element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path schema1:identifier ],
        [ sh:description "Package bucket." ;
            sh:in ( "CORE" "STDLIB" "BACKENDS" "FORMATTERS" "HELPERS" "PLUGINS" "TELEMETRY" "CLI" "DOCS_EXAMPLES" "TEST" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
