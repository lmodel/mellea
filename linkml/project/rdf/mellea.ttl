<https://w3id.org/lmodel/mellea/PythonDottedPath> a linkml:TypeDefinition ;
    skos:inScheme "https://w3id.org/lmodel/mellea"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/lmodel/mellea/PythonDottedPath"^^xsd:anyURI ;
    linkml:description "Python import-style dotted path." ;
