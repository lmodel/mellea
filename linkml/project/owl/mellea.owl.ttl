            owl:onProperty mellea:watsonx_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:watsonx_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:bedrock_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:hf_model_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:bedrock_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:ollama_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:ollama_name ],
        mellea:NamedElement ;
    skos:closeMatch nexus:AiModel,
        nexus:LargeLanguageModel,
        spdx:AIPackage,
        gist_linkml:ID ;
    skos:definition "Cross-provider identifier table for a single model." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch nexus:ModelInfo,
        common_domain_model:positionIdentifier,
        mcp:ModelHint .

mellea:PythonPackage a owl:Class ;
    rdfs:label "PythonPackage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:package_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:depends_on_package ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:package_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:ModelElement ;
            owl:onProperty mellea:declares_element ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:declares_element ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:PythonPackage ;
            owl:onProperty mellea:depends_on_package ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:package_name ],
        mellea:NamedElement ;
    skos:closeMatch spdx:Package,
        gist_linkml:Composite ;
    skos:definition "A logical Python package (directory) inside the repository." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:narrowMatch nexus:Entity ;
    skos:relatedMatch common_domain_model:Position .

