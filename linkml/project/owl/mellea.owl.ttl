mellea:ModelElement a owl:Class ;
    rdfs:label "ModelElement" ;
    rdfs:subClassOf [ owl:unionOf ( mellea:ApiModelSpec mellea:BackendSpec mellea:CliCommandSpec mellea:ComponentSpec mellea:ContextSpec mellea:FormatterSpec mellea:HookPayloadSpec mellea:PluginSpec mellea:RequirementSpec mellea:SamplingStrategySpec mellea:SessionSpec mellea:TelemetryMetricSpec ) ],
        mellea:NamedElement ;
    skos:broadMatch gist_linkml:Specification ;
    skos:definition "Abstract base for concrete architectural elements." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch spdx:Element,
        common_domain_model:ContractBase .

mellea:HookTypeEnum a owl:Class ;
