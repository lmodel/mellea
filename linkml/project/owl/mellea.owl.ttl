mellea:AdapterTypeEnum a owl:Class ;
    rdfs:label "AdapterTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/mellea/AdapterTypeEnum#LORA> <https://w3id.org/lmodel/mellea/AdapterTypeEnum#ALORA> ) ;
    skos:definition "Adapter implementation type (derived from AdapterType)." ;
    skos:exactMatch nexus:AdapterType ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    linkml:permissible_values <https://w3id.org/lmodel/mellea/AdapterTypeEnum#ALORA>,
        <https://w3id.org/lmodel/mellea/AdapterTypeEnum#LORA> ;
    mellea:derived_from "mellea/backends/adapters/catalog.py::AdapterType" .

mellea:ContextLinearityEnum a owl:Class ;
    rdfs:label "ContextLinearityEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/mellea/ContextLinearityEnum#LINEAR> <https://w3id.org/lmodel/mellea/ContextLinearityEnum#NON_LINEAR> ) ;
    skos:definition "Whether a Mellea context preserves linear ordering or not." ;
