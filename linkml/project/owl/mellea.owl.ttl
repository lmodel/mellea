        <https://w3id.org/lmodel/mellea/PluginModeEnum#FIRE_AND_FORGET>,
        <https://w3id.org/lmodel/mellea/PluginModeEnum#SEQUENTIAL>,
        <https://w3id.org/lmodel/mellea/PluginModeEnum#TRANSFORM> ;
