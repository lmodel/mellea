mellea:CoverageScopeEnum a owl:Class ;
    rdfs:label "CoverageScopeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/mellea/CoverageScopeEnum#SOURCE> <https://w3id.org/lmodel/mellea/CoverageScopeEnum#API> <https://w3id.org/lmodel/mellea/CoverageScopeEnum#CLI> <https://w3id.org/lmodel/mellea/CoverageScopeEnum#EXAMPLE> <https://w3id.org/lmodel/mellea/CoverageScopeEnum#TEST> ) ;
    skos:definition "Where in the project an element surfaces (source, API, CLI, ...)." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    linkml:permissible_values <https://w3id.org/lmodel/mellea/CoverageScopeEnum#API>,
        <https://w3id.org/lmodel/mellea/CoverageScopeEnum#CLI>,
        <https://w3id.org/lmodel/mellea/CoverageScopeEnum#EXAMPLE>,
        <https://w3id.org/lmodel/mellea/CoverageScopeEnum#SOURCE>,
        <https://w3id.org/lmodel/mellea/CoverageScopeEnum#TEST> .

mellea:NamedElement a owl:Class ;
    rdfs:label "NamedElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:package_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:CoverageScopeEnum ;
            owl:onProperty mellea:coverage_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:source_file ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:coverage_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty mellea:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mellea:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:source_file ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:element_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:module_path ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:module_path ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:package_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:source_file ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:element_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mellea:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:module_path ],
        [ owl:unionOf ( mellea:ApiFieldSpec mellea:IntrinsicAdapterSpec mellea:MethodSpec mellea:ModelElement mellea:ModelIdentifierSpec mellea:PythonPackage mellea:RepositoryCatalog ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:PackageKindEnum ;
            owl:onProperty mellea:package_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:ElementKindEnum ;
            owl:onProperty mellea:element_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:name ] ;
    skos:closeMatch nexus:Entity,
        spdx:Element,
        gist_linkml:GistThing,
        iso27001:NamedEntity ;
    skos:definition "Abstract base for any named, identifiable schema element." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch attack:StixEntity,
        common_domain_model:InventoryRecord,
        mcp:HasName .

