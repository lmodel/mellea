    skos:relatedMatch spdx:Agent,
        attack:Infrastructure ;
    linkml:permissible_values <https://w3id.org/lmodel/mellea/BackendFamilyEnum#BEDROCK>,
        <https://w3id.org/lmodel/mellea/BackendFamilyEnum#DUMMY>,
        <https://w3id.org/lmodel/mellea/BackendFamilyEnum#HUGGINGFACE>,
        <https://w3id.org/lmodel/mellea/BackendFamilyEnum#LITELLM>,
        <https://w3id.org/lmodel/mellea/BackendFamilyEnum#OLLAMA>,
        <https://w3id.org/lmodel/mellea/BackendFamilyEnum#OPENAI>,
        <https://w3id.org/lmodel/mellea/BackendFamilyEnum#WATSONX> ;
    mellea:derived_from "mellea/backends/*.py" .

