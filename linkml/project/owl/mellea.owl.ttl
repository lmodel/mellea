@prefix attack: <https://w3id.org/lmodel/attack/> .
@prefix common_domain_model: <https://w3id.org/lmodel/common-domain-model/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gist_linkml: <https://w3id.org/lmodel/gist/> .
@prefix iso27001: <https://w3id.org/lmodel/iso27001/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix mcp: <https://w3id.org/lmodel/mcp/> .
@prefix mellea: <https://w3id.org/lmodel/mellea/> .
@prefix nexus: <https://ibm.github.io/ai-atlas-nexus/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <https://spdx.org/rdf/3.0.1/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/mellea.owl.ttl> a owl:Ontology ;
    rdfs:label "mellea" ;
    dcterms:license "Apache-2.0" ;
    dcterms:source <https://github.com/lmodel/mellea> ;
    dcterms:title "mellea" ;
    pav:version "2026-05-26" ;
    rdfs:seeAlso <https://github.com/lmodel/mellea>,
        <https://lmodel.github.io/mellea> ;
    skos:definition "LinkML schema describing the Mellea codebase architecture and public data models. Generated from Python sources by linkml/scripts/schema_to_linkml.py." ;
    mellea:analyzed_scope "mellea+cli (linkml/ excluded)" ;
    mellea:coverage_inventory """cli: total=86 (CLASS=42 DATACLASS=5 ENUM=4 PYDANTIC_MODEL=20 TYPED_DICT=15)
mellea/backends: total=28 (CLASS=22 DATACLASS=2 ENUM=1 MIXIN=1 PYDANTIC_MODEL=2)
mellea/core: total=27 (CLASS=20 DATACLASS=5 ENUM=1 PROTOCOL=1)
mellea/formatters: total=57 (CLASS=39 ENUM=1 MIXIN=1 PYDANTIC_MODEL=16)
mellea/helpers: total=6 (CLASS=2 ENUM=1 PYDANTIC_MODEL=1 TYPED_DICT=2)
mellea/plugins: total=32 (CLASS=28 DATACLASS=2 ENUM=2)
mellea/stdlib: total=69 (CLASS=50 DATACLASS=10 ENUM=1 PROTOCOL=2 PYDANTIC_MODEL=4 TYPED_DICT=2)
mellea/telemetry: total=11 (CLASS=11)
enum_total: 11""" ;
    mellea:coverage_target "core-library-and-cli" ;
    mellea:generated_by "linkml/scripts/schema_to_linkml.py" ;
    mellea:generated_on "2026-05-26" .

mellea:uses_component_type a owl:ObjectProperty ;
    rdfs:label "uses_component_type" ;
    rdfs:range mellea:ComponentSpec ;
    skos:definition "Slot describing the uses component type." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> .

mellea:CliCommandSpec a owl:Class ;
    rdfs:label "CliCommandSpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:command_purpose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:input_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:command_group ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:command_purpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:command_path ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:output_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:ApiModelSpec ;
            owl:onProperty mellea:input_model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:command_path ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:command_group ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:command_path ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:ApiModelSpec ;
            owl:onProperty mellea:output_model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:command_purpose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:command_group ],
        mellea:ModelElement ;
    skos:closeMatch gist_linkml:TaskTemplate ;
    skos:definition "Specification of a CLI command exposed under `m`." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch spdx:Tool,
        attack:Tool,
        iso27001:OperationalProcedure .

mellea:IntrinsicAdapterSpec a owl:Class ;
    rdfs:label "IntrinsicAdapterSpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:repo_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:AdapterTypeEnum ;
            owl:onProperty mellea:adapter_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:repo_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:adapter_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:repo_id ],
        mellea:NamedElement ;
    skos:closeMatch nexus:Adapter,
        nexus:LLMIntrinsic,
        spdx:AIPackage ;
    skos:definition "Specification of an intrinsic adapter (LoRA / aLoRA)." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch spdx:Relationship,
        gist_linkml:Component .

mellea:PluginSpec a owl:Class ;
    rdfs:label "PluginSpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom mellea:PluginModeEnum ;
            owl:onProperty mellea:plugin_mode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:plugin_priority ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:plugin_mode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:payload_model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:plugin_mode ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:HookTypeEnum ;
            owl:onProperty mellea:hook_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:HookPayloadSpec ;
            owl:onProperty mellea:payload_model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:hook_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty mellea:plugin_priority ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:plugin_priority ],
        mellea:ModelElement ;
    skos:closeMatch spdx:Extension ;
    skos:definition "Specification of a Mellea plugin and the hooks it registers." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch nexus:AIComponent,
        attack:Analytic,
        gist_linkml:Component,
        iso27001:OperationalProcedure,
        mcp:ExtensionAppCapability .

mellea:RepositoryCatalog a owl:Class ;
    rdfs:label "RepositoryCatalog" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom mellea:ModelElement ;
            owl:onProperty mellea:declares_element ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:repository_root ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:declares_element ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:analyzed_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:includes_path ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:excludes_path ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:repository_root ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:includes_path ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:repository_root ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty mellea:analyzed_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:excludes_path ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:analyzed_on ],
        mellea:NamedElement ;
    skos:closeMatch spdx:Sbom,
        gist_linkml:Collection ;
    skos:definition "Top-level catalog rooting the analysed repository snapshot." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch nexus:Container,
        spdx:SpdxDocument,
        attack:AttackBundle,
        common_domain_model:Portfolio,
        common_domain_model:PortfolioState,
        iso27001:DocumentedInformation .

mellea:RequirementSpec a owl:Class ;
    rdfs:label "RequirementSpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty mellea:may_trigger_repair ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:may_trigger_repair ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:may_trigger_repair ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:validation_style ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:validation_style ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:validation_style ],
        mellea:ModelElement ;
    skos:closeMatch gist_linkml:Requirement ;
    skos:definition "Specification of a requirement validator." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch nexus:Requirement,
        nexus:Rule,
        iso27001:InformationSecurityObjective,
        iso27001:SecurityControl .

mellea:SamplingStrategySpec a owl:Class ;
    rdfs:label "SamplingStrategySpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty mellea:loop_budget_hint ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:selection_policy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:may_trigger_repair ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:loop_budget_hint ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty mellea:may_trigger_repair ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:loop_budget_hint ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:selection_policy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:may_trigger_repair ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:selection_policy ],
        mellea:ModelElement ;
    skos:closeMatch mcp:SamplingCapability ;
    skos:definition "Specification of a sampling-loop strategy." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch nexus:Action,
        gist_linkml:Behavior,
        mcp:ModelPreferences .

mellea:SessionSpec a owl:Class ;
    rdfs:label "SessionSpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:uses_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:MethodSpec ;
            owl:onProperty mellea:exposed_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:BackendSpec ;
            owl:onProperty mellea:uses_backend ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:uses_backend ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:uses_backend ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:uses_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:ContextSpec ;
            owl:onProperty mellea:uses_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:exposed_method ],
        mellea:ModelElement ;
    skos:definition "Specification of a Mellea session." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch nexus:AiTask,
        gist_linkml:Task,
        iso27001:RiskAssessmentProcess,
        mcp:Task .

mellea:TelemetryMetricSpec a owl:Class ;
    rdfs:label "TelemetryMetricSpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:metric_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:metric_name ],
        mellea:ModelElement ;
    skos:closeMatch nexus:MetricConfig,
        iso27001:MonitoringItem ;
    skos:definition "Specification of a telemetry metric emitted by Mellea." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch nexus:AiEval,
        spdx:AIPackage,
        attack:DataSource,
        gist_linkml:Magnitude,
        iso27001:MonitoringProgram .

