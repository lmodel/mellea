mellea:ComponentSpec a owl:Class ;
    rdfs:label "ComponentSpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:parsed_output_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:input_modality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:input_modality ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:ComponentCategoryEnum ;
            owl:onProperty mellea:component_category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:component_category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:parsed_output_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:parsed_output_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:component_category ],
        mellea:ModelElement ;
    skos:closeMatch nexus:AIComponent,
        gist_linkml:Component,
        mcp:Tool ;
    skos:definition "Specification of a Mellea stdlib component type." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> .

