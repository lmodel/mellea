mellea:ApiModelSpec a owl:Class ;
    rdfs:label "ApiModelSpec" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mellea:openai_object_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:openai_object_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:RequestResponseEnum ;
            owl:onProperty mellea:request_or_response ],
        [ a owl:Restriction ;
            owl:allValuesFrom mellea:ApiFieldSpec ;
            owl:onProperty mellea:has_field ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:has_field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:request_or_response ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mellea:openai_object_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mellea:request_or_response ],
        mellea:ModelElement ;
    skos:closeMatch gist_linkml:Specification ;
    skos:definition "Specification of an HTTP API wire model." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    skos:relatedMatch nexus:Input,
        mcp:JSONRPCRequest,
        mcp:JSONRPCResponse .

mellea:RequestResponseEnum a owl:Class ;
    rdfs:label "RequestResponseEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/mellea/RequestResponseEnum#REQUEST> <https://w3id.org/lmodel/mellea/RequestResponseEnum#RESPONSE> <https://w3id.org/lmodel/mellea/RequestResponseEnum#BOTH> ) ;
    skos:definition "Direction of a wire model (HTTP request, response, or both)." ;
    skos:inScheme <https://w3id.org/lmodel/mellea> ;
    linkml:permissible_values <https://w3id.org/lmodel/mellea/RequestResponseEnum#BOTH>,
        <https://w3id.org/lmodel/mellea/RequestResponseEnum#REQUEST>,
        <https://w3id.org/lmodel/mellea/RequestResponseEnum#RESPONSE> .

